# Copy this file to supabase/functions/.env (which git ignores).
# These values stay ON THE SERVER. This is the only place the Claude key goes.
#   local:  `npm run functions:serve` reads this file
#   hosted: `npx supabase secrets set --env-file supabase/functions/.env`

# mock | claude | http
IDENTIFIER_PROVIDER=mock

# Required when IDENTIFIER_PROVIDER=claude. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model to use.
CLAUDE_MODEL=claude-sonnet-5-5

# Identifications per user per day (admins are unlimited).
DAILY_IDENTIFICATION_LIMIT=5

# For a future self-hosted model (IDENTIFIER_PROVIDER=http).
IDENTIFIER_HTTP_URL=
IDENTIFIER_HTTP_TOKEN=
IDENTIFIER_HTTP_MODEL=

# Copy this file to .env (which git ignores) and fill it in.
#
# Everything in this file is bundled INTO THE APP, so anyone can read it.
# Only public values belong here. NEVER put an AI provider key (or any other
# secret) in this file. Those go in supabase/functions/.env (server only).

# local-mock : identification runs inside the app with pretend answers. No server needed.
# remote     : the app calls the Supabase "identify" function, which picks the
#              provider (mock or Claude) on the server.
EXPO_PUBLIC_IDENTIFIER_MODE=local-mock

# Needed for remote mode. `npm run db:start` prints both values for local development.
# The publishable key (sb_publishable_..., formerly the "anon" key) is designed to be
# public; Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to false to stop users correcting identifications.
EXPO_PUBLIC_ALLOW_USER_CORRECTIONS=true
